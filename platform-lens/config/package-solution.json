    },
    "metadata": {
      "shortDescription": {
        "default": "Platform Lens - Power Platform admin center and Microsoft 365 governance dashboards"
      },
      "longDescription": {
        "default": "A CoE-style Power Platform admin center inside SharePoint: environments, apps, cloud flows, Copilot Studio agents, makers, connectors and DLP, licensing and Dataverse capacity, and a governance worklist, plus Microsoft 365 dashboards for SharePoint sites, Teams and groups, licensing and adoption, and identity. Every page exports to Excel, PDF and CSV. Data is read live with the signed-in administrator's delegated permissions."
      },
      "screenshotPaths": []
    },
    "webApiPermissionRequests": [
      { "resource": "Microsoft Graph", "scope": "User.Read.All" },
      { "resource": "Microsoft Graph", "scope": "Group.Read.All" },
      { "resource": "Microsoft Graph", "scope": "Organization.Read.All" },
      { "resource": "Microsoft Graph", "scope": "Reports.Read.All" },
      { "resource": "Microsoft Graph", "scope": "ReportSettings.Read.All" },
      { "resource": "Microsoft Graph", "scope": "Sites.Read.All" },
      { "resource": "Microsoft Graph", "scope": "SharePointTenantSettings.Read.All" },
      { "resource": "Microsoft Graph", "scope": "AuditLog.Read.All" },
      { "resource": "Microsoft Graph", "scope": "RoleManagement.Read.Directory" },
      { "resource": "Microsoft Graph", "scope": "Application.Read.All" },
      { "resource": "Microsoft Graph", "scope": "ServiceHealth.Read.All" },
      { "resource": "Microsoft Graph", "scope": "ServiceMessage.Read.All" },
      { "resource": "PowerApps Service", "scope": "User" },
      { "resource": "Microsoft Flow Service", "scope": "Flows.Read.All" },
      { "resource": "Microsoft Flow Service", "scope": "User" },
      { "resource": "Dynamics CRM", "scope": "user_impersonation" }
