{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx/client-side-web-part-manifest.schema.json",
  "id": "3c8e4b2a-7f15-4d6b-9a0e-1b2c3d4e5f61",
  "alias": "PlatformHubWebPart",
  "componentType": "WebPart",

  // The "*" signifies that the version should be taken from the package.json
  "version": "*",
  "manifestVersion": 2,

  "requiresCustomScript": false,
  "supportedHosts": ["SharePointWebPart", "SharePointFullPage", "TeamsPersonalApp", "TeamsTab"],
  "supportsThemeVariants": true,
  "supportsFullBleed": true,

  "preconfiguredEntries": [{
    "groupId": "5c03119e-3074-46fd-976b-c60198311f70", // Advanced
    "group": { "default": "Advanced" },
    "title": { "default": "Platform Lens" },
    "description": { "default": "Power Platform admin center and Microsoft 365 governance dashboards with Excel, PDF and CSV export." },
    "iconImageUrl": "data:image/png;base64,",
    "properties": {
      "title": "Platform Lens",
      "dataSource": "live",
      "includeDataverse": true,
      "maxRows": 50000,
      "defaultPage": "overview"
    }
  }]
}
